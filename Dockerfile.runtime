# Для серверов, где мало памяти: всё собирается заранее на своей машине, здесь только рантайм.
#   npm run build
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o dist/kkmt ./server
FROM gcr.io/distroless/static
ENV PUBLIC_DIR=/public
ENV UPLOAD_DIR=/data/uploads
COPY dist/kkmt /kkmt
COPY dist/public /public
EXPOSE 3000
ENTRYPOINT ["/kkmt"]
